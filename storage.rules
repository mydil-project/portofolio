rules_version = '2';

/* =========================================================
   FILE INI OPSIONAL.
   Cloud Storage for Firebase hanya bisa dipakai kalau project
   sudah di-upgrade ke plan Blaze. Kalau gambar project memakai
   path di repository (assets/img/projects/...), file ini tidak
   perlu di-deploy sama sekali.

   Dipakai hanya kalau kamu aktifkan upload gambar dari dashboard.
   ========================================================= */

service firebase.storage {
  match /b/{bucket}/o {

    /* GANTI EMAIL DI BAWAH dengan email admin kamu. */
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['aidilfebrian01@gmail.com'];
    }

    /* Gambar project: publik bisa melihat, hanya admin yang bisa upload.
       Batas ukuran 5 MB dan hanya file gambar. */
    match /projects/{projectId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}