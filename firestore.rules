rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =======================================================
       EMAIL ADMIN SUDAH DIISI.
       Kalau suatu saat ganti email, ubah juga di 2 tempat lain:
       - js/site-config.js  -> firebase.adminEmails
       - Akun di Firebase Console > Authentication > Users
       ======================================================= */

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['aidilfebrian01@gmail.com'];
    }

    /* ---------- PROJECTS ----------
       Publik  : hanya boleh membaca project "published"
       Admin   : baca, tambah, edit, hapus */
    match /projects/{projectId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /* ---------- PROFILE (informasi portfolio) ---------- */
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---------- SKILLS ---------- */
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---------- SERTIFIKASI ----------
       Publik  : hanya boleh membaca sertifikat "published"
       Admin   : baca, tambah, edit, hapus */
    match /certifications/{certId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /* ---------- LAINNYA: TOLAK SEMUA ---------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}